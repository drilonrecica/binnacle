{
  "name": "@binnacle/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/compress.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "contrast": "node scripts/contrast.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test --config=playwright.visual.config.ts visual.spec.ts",
    "test:landing": "playwright test --config=playwright.landing.config.ts",
    "test:acceptance": "playwright test --config=playwright.acceptance.config.ts",
    "screenshots": "node scripts/demo-screenshots.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@lucide/svelte": "1.39.0",
    "svelte": "^5.57.3",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
